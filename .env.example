# Root environment file used by Docker Compose. Do not commit your real .env.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-another-long-random-secret
HTTP_PORT=80
# Local Docker default. On AWS, change this to http://YOUR_APP_PUBLIC_IP or your HTTPS domain.
FRONTEND_ORIGIN=http://localhost,http://localhost:3000
